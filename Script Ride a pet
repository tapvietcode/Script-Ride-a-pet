-- ==========================================
-- 5. SMART EGG FINDER (1M - 1Qa) - OUTSIDE BASE ONLY
-- ==========================================
local function parseEggValue(str)
    str = str:upper()
    local num = tonumber(str:match("[%d%.]+"))
    if not num then return 0 end
    if str:find("QA") then
        num = num * 1e15
    elseif str:find("T") then
        num = num * 1e12
    elseif str:find("B") then
        num = num * 1e9
    elseif str:find("M") then
        num = num * 1e6
    elseif str:find("K") then
        num = num * 1e3
    end
    return num
end

-- Function to check if an object is inside a base/plot
local function isInsideBase(item)
    local current = item.Parent
    while current and current ~= workspace do
        local name = current.Name:lower()
        if name:find("base") or name:find("plot") or name:find("tycoon") or name:find("home") then
            return true
        end
        current = current.Parent
    end
    return false
end

EggTeleportBtn.MouseButton1Click:Connect(function()
    local bestEgg = nil
    local maxVal = -1
    local minTarget = 1e6   -- 1M
    local maxTarget = 1e15  -- 1Qa

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (string.find(obj.Name:lower(), "egg") or string.find(obj.Name:lower(), "trứng")) then
            -- Chỉ lấy trứng ở ngoài base (bỏ qua trứng ở trong base)
            if not isInsideBase(obj) then
                local eval = parseEggValue(obj.Name)
                for _, desc in ipairs(obj:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local parsed = parseEggValue(desc.Text)
                        if parsed > eval then
                            eval = parsed
                        end
                    end
                end

                if eval >= minTarget and eval <= maxTarget and eval > maxVal then
                    maxVal = eval
                    bestEgg = obj
                end
            end
        end
    end

    -- Fallback: nếu không tìm thấy trong khoảng 1M-1Qa ở ngoài map, tìm trứng cao nhất ở ngoài map
    if not bestEgg then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (string.find(obj.Name:lower(), "egg") or string.find(obj.Name:lower(), "trứng")) then
                if not isInsideBase(obj) then
                    local eval = parseEggValue(obj.Name)
                    if eval > maxVal then
                        maxVal = eval
                        bestEgg = obj
                    end
                end
            end
        end
    end

    if bestEgg and bestEgg:FindFirstChildWhichIsA("BasePart") then
        RootPart.CFrame = bestEgg:FindFirstChildWhichIsA("BasePart").CFrame + Vector3.new(0, 3, 0)
    else
        print("Không tìm thấy trứng nào ở bên ngoài bản đồ!")
    end
end)
